    { "source": "/peace", "destination": "/index.html" },
    { "source": "/countries", "destination": "/index.html" },
    { "source": "/countries/:path*", "destination": "/index.html" },
    { "source": "/country", "destination": "/index.html" },
    { "source": "/country/:path*", "destination": "/index.html" },
    { "source": "/ghana", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/jobs/:path*", "destination": "/index.html" },
    { "source": "/job", "destination": "/index.html" },
    { "source": "/job/:path*", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/impact", "destination": "/index.html" },
    { "source": "/data-gaps", "destination": "/index.html" },
    { "source": "/sdgs", "destination": "/index.html" },
    { "source": "/my-map", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/partners", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/sports", "destination": "/index.html" },
    { "source": "/unity-ball", "destination": "/index.html" },
    { "source": "/funding", "destination": "/index.html" },
    { "source": "/schools", "destination": "/index.html" },
    { "source": "/universities", "destination": "/index.html" },
